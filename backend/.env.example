# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# IPLogs API Configuration (VPN & Proxy Detection Provider)
# Official Documentation: https://iplogs.com/docs
# Leave blank to operate with fallback real intelligence or enter your key:
IPLOGS_API_KEY=
IPLOGS_API_URL=https://iplogs.com/v1/check
IPLOGS_TIMEOUT_MS=6000

# Supabase PostgreSQL & Auth Configuration
# Sign up at https://supabase.com (Free Tier)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rate Limiting Configuration
RATE_LIMIT_MAX=100
BULK_MAX_IPS=50
